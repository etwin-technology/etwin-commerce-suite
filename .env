# ETWIN Commerce — frontend env
# Set this to your live PHP API base URL.
# When empty, the frontend runs in DEMO MODE using local mock data — DO NOT deploy that way.
#
# Local Laragon dev:
#   - Built-in PHP server (recommended, default below): http://127.0.0.1:8080
#       Run from Laragon terminal:  php -S 127.0.0.1:8080 -t backend-php/public
#   - Apache vhost (Laragon .test domain):              http://etwin-api.test
#
# Production: e.g. https://api.etwin.app
#
# After changing this value, RESTART the Vite dev server — Vite reads .env only at startup.
VITE_PHP_API_BASE="http://127.0.0.1:8080"

# Storefront subdomains — must match backend APP_DOMAIN / STOREFRONT_URL_PATTERN.
# Local dev (no wildcard DNS):
#   VITE_APP_DOMAIN=
#   VITE_STOREFRONT_URL_PATTERN=path
# Local Laragon wildcard (etwin.test → 127.0.0.1, *.etwin.test wildcard vhost):
#   VITE_APP_DOMAIN=etwin.test
#   VITE_STOREFRONT_URL_PATTERN=http://{slug}.{domain}
# Production:
#   VITE_APP_DOMAIN=etwin.app
#   VITE_STOREFRONT_URL_PATTERN=https://{slug}.{domain}
VITE_APP_DOMAIN=""
VITE_STOREFRONT_URL_PATTERN="path"

# Hide the test/demo login picker on the login page (set to "1" in production).
# When 0 (default), the picker shows the seeded test accounts:
#   demo@etwin.app / admin@etwin.app / superadmin@etwin.app   (pwd: demo1234)
VITE_HIDE_DEMO_LOGIN="0"

# ETWIN Commerce — backend env (copy to backend-php/.env for local dev)
# Real OS environment variables ALWAYS override values in this file.
#
# ── Production checklist ─────────────────────────────────────────────
#   APP_ENV=production               (enables strict secret validation)
#   JWT_SECRET                       ≥ 32 chars  → bin2hex(random_bytes(32))
#   TELEGRAM_WEBHOOK_SECRET          ≥ 16 chars  → bin2hex(random_bytes(16))
#   DB_PASS                          non-empty
#   CORS_ALLOW_ORIGIN                exact origin (no "*")
#   APP_BASE_URL                     https URL of the dashboard SPA
#   APP_DOMAIN                       e.g. etwin.app  (used for storefront subdomains)
#   STOREFRONT_URL_PATTERN           https://{slug}.{domain}
#   FORCE_HTTPS=true                 (or rely on the APP_ENV=production default)
#   SERVER_IP                        public IPv4 of this server (custom-domain DNS)
# ─────────────────────────────────────────────────────────────────────

APP_ENV=development

# ── Database (Laragon defaults: root user, empty password, localhost MySQL) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=etwin_commerce
DB_USER=root
DB_PASS=

# ── Auth ──
# In dev a placeholder is fine; in production set APP_ENV=production and use
#   php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=dev-only-secret-change-me-please-replace-now-32+chars

# ── Telegram (optional in dev — leave blank if you don't use it) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── CORS ──
# Vite dev server default. Add the .test host here too if you serve the frontend
# through Laragon (comma-separated origins are NOT supported by the browser; use
# the single origin you actually load the app from).
CORS_ALLOW_ORIGIN=http://localhost:5173

# ── Frontend URL (used in emails, links) ──
APP_BASE_URL=http://localhost:5173

# ── Storefront subdomains ──
# When a user creates a store, the public URL is built from these.
# {slug} is replaced with the store's slug.
# Local dev (Laragon wildcard host *.etwin.test):
#   APP_DOMAIN=etwin.test
#   STOREFRONT_URL_PATTERN=http://{slug}.{domain}
# Production:
#   APP_DOMAIN=etwin.app
#   STOREFRONT_URL_PATTERN=https://{slug}.{domain}
# Path fallback (no subdomain DNS available — uses APP_BASE_URL/store/{slug}):
#   STOREFRONT_URL_PATTERN=path
APP_DOMAIN=localhost:5173
STOREFRONT_URL_PATTERN=path

# ── Server public IP (used in custom-domain DNS verification) ──
SERVER_IP=0.0.0.0

# ── Login throttling (per ip+email, in seconds) ──
LOGIN_THROTTLE_MAX=8
LOGIN_THROTTLE_WINDOW=600

# ── HTTPS — keep false for local dev ──
FORCE_HTTPS=false
